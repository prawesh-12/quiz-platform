DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/auth_db?sslmode=require
JWT_SECRET=change-me            # same across all services
JWT_EXPIRES_IN=8h
INTERNAL_KEY=change-me          # same as questionbank
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=            # bcrypt hash
ADMIN_NAME=Admin
REDIS_URL=redis://localhost:6379
CLIENT_URLS=                    # comma-separated allowed origins, e.g. http://localhost:5173
COOKIE_SECURE=false             # true in prod (HTTPS gateway)
COOKIE_SAMESITE=lax             # lax works because the SPA proxies /api same-origin
