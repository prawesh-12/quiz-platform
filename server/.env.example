PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quizdb
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=bcrypt_hash_here
ADMIN_NAME=Main Admin
# CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://localhost:4173
NODE_ENV=development
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=10000
PG_POOL_CONNECTION_TIMEOUT_MS=3000
# Hard cap on any single SQL statement so a stuck query can't hold a connection.
PG_STATEMENT_TIMEOUT_MS=15000
AUTO_SUBMIT_BATCH_SIZE=100

# ---- Scheduler / worker split ----
# API instances: set false (the worker owns transitions). Worker: set true.
# Safe either way — a Postgres advisory lock guarantees a single owner.
SCHEDULER_ENABLED=true
# Worker runs startup migrations by default; set false if the API already does.
WORKER_RUN_MIGRATIONS=true

# ---- HTTP timeouts / body size ----
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
JSON_BODY_LIMIT=256kb

# ---- Caching (process-local TTLs; seconds-scale to bound staleness) ----
LIVE_STATS_TTL_MS=3000
DASHBOARD_SUMMARY_TTL_MS=30000
DASHBOARD_TREND_TTL_MS=60000

# ---- Redis (OPTIONAL) ----
# Shared cache + coordination: quiz snapshots, live-stats/dashboard cache, prewarm
# locks, distributed rate limits. Leave unset to run without Redis (PostgreSQL +
# in-process fallback). Start one with: docker compose up -d redis
# REDIS_URL=redis://localhost:6379
# How long the per-request revoked-token check is cached (logout invalidates it).
REVOKED_TOKEN_CACHE_TTL_MS=60000
# Student snapshot TTL and prewarm cadence (worker prewarms quizzes starting soon).
QUIZ_SNAPSHOT_TTL_MS=14400000
QUIZ_PREWARM_WINDOW_MINUTES=2
QUIZ_PREWARM_INTERVAL_MS=30000
QUIZ_PREWARM_LOCK_MS=60000

# ---- Observability ----
LOG_LEVEL=info
# Optional: enables the error-monitor seam (no-op when unset).
# SENTRY_DSN=

# ---- Load testing ----
# Disables all rate limiting so a single-host k6 run isn't throttled by per-IP limits.
# NEVER set true in production.
# RATE_LIMIT_DISABLED=true
